{#
 # Dashboard — CONTROLE DE CONTRATOS. Stat cards + tabela de vencimentos (Tabler).
 #}
<div class="container-fluid">
   <h2 class="mb-3"><i class="ti ti-dashboard me-2"></i>{{ __('CONTROLE DE CONTRATOS', 'controlecontratos') }}</h2>

   <div class="row row-cards mb-4">
      {# Ativos #}
      <div class="col-sm-6 col-lg-3">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-primary text-white avatar"><i class="ti ti-file-certificate"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.active }}</div>
                     <div class="text-secondary">{{ __('Contratos ativos', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Próximos 30 dias #}
      <div class="col-sm-6 col-lg-3">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-warning text-white avatar"><i class="ti ti-clock-hour-4"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.next30 }}</div>
                     <div class="text-secondary">{{ __('Vencem em 30 dias', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Próximos 60 dias #}
      <div class="col-sm-6 col-lg-3">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-yellow text-white avatar"><i class="ti ti-calendar-event"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.next60 }}</div>
                     <div class="text-secondary">{{ __('Vencem em 60 dias', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Vencidos #}
      <div class="col-sm-6 col-lg-3">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-danger text-white avatar"><i class="ti ti-alert-triangle"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.expired }}</div>
                     <div class="text-secondary">{{ __('Vencidos', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>

   <div class="card">
      <div class="card-header"><h3 class="card-title">{{ __('Próximos vencimentos (60 dias)', 'controlecontratos') }}</h3></div>
      <div class="table-responsive">
         <table class="table table-vcenter card-table">
            <thead>
               <tr>
                  <th>{{ __('Tipo', 'controlecontratos') }}</th>
                  <th>{{ __('Nome', 'controlecontratos') }}</th>
                  <th>{{ __('Fornecedor / Cliente', 'controlecontratos') }}</th>
                  <th>{{ __('Término', 'controlecontratos') }}</th>
                  <th>{{ __('Situação', 'controlecontratos') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for row in expiring %}
                  <tr>
                     <td>{{ row.kind_badge|raw }}</td>
                     <td><a href="{{ form_url }}?id={{ row.id }}">{{ row.name }}</a></td>
                     <td>{{ row.partner }}</td>
                     <td>{{ row.date_end|date('d/m/Y') }}</td>
                     <td>{{ row.status_badge|raw }}</td>
                  </tr>
               {% else %}
                  <tr><td colspan="5" class="text-center text-secondary">{{ __('Nenhum contrato a vencer nos próximos 60 dias.', 'controlecontratos') }}</td></tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   </div>
</div>
