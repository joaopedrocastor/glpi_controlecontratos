{#
 # Dashboard — CONTROLE DE CONTRATOS. Stat cards + tabela de vencimentos (Tabler).
 #}
<div class="container-fluid">
   <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
      <h2 class="mb-0"><i class="ti ti-dashboard me-2"></i>{{ __('CONTROLE DE CONTRATOS', 'controlecontratos') }}</h2>
      <div>
         <a href="{{ form_url }}" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i>{{ __('Novo Contrato / Licença', 'controlecontratos') }}
         </a>
      </div>
   </div>

   {# Filtros por tipo — recarregam o PRÓPRIO Dashboard filtrado (o ativo fica destacado) #}
   <div class="mb-3">
      <a href="{{ dash_all }}" class="btn btn-sm me-1 {{ active_kind is null ? 'btn-secondary' : 'btn-outline-secondary' }}">
         <i class="ti ti-list me-1"></i>{{ __('Todos', 'controlecontratos') }}
      </a>
      <a href="{{ dash_contract }}" class="btn btn-sm me-1 {{ active_kind == 'contract' ? 'btn-primary' : 'btn-outline-primary' }}">
         <i class="ti ti-file-certificate me-1"></i>{{ __('Contratos', 'controlecontratos') }}
      </a>
      <a href="{{ dash_license }}" class="btn btn-sm me-1 text-white"
         style="background-color:{{ active_kind == 'license' ? '#ae3ec9' : '#c98fd9' }}">
         <i class="ti ti-license me-1"></i>{{ __('Licenças', 'controlecontratos') }}
      </a>
      <a href="{{ dash_certificate }}" class="btn btn-sm me-1 {{ active_kind == 'certificate' ? 'btn-success' : 'btn-outline-success' }}">
         <i class="ti ti-certificate me-1"></i>{{ __('Certificados', 'controlecontratos') }}
      </a>
      <a href="{{ dash_domain }}" class="btn btn-sm {{ active_kind == 'domain' ? 'btn-cyan text-white' : 'btn-outline-cyan' }}">
         <i class="ti ti-world me-1"></i>{{ __('Domínios', 'controlecontratos') }}
      </a>
   </div>

   <div class="row row-cards mb-4">
      {# Total de Contratos #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-blue text-white avatar"><i class="ti ti-file-certificate"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.contracts }}</div>
                     <div class="text-secondary">{{ __('Contratos', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Total de Licenças #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="text-white avatar" style="background-color:#ae3ec9"><i class="ti ti-license"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.licenses }}</div>
                     <div class="text-secondary">{{ __('Licenças', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Total de Certificados #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-green text-white avatar"><i class="ti ti-certificate"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.certificates }}</div>
                     <div class="text-secondary">{{ __('Certificados', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Total de Domínios #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-cyan text-white avatar"><i class="ti ti-world"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.domains }}</div>
                     <div class="text-secondary">{{ __('Domínios', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Próximos 30 dias #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-warning text-white avatar"><i class="ti ti-clock-hour-4"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.next30 }}</div>
                     <div class="text-secondary">{{ __('Vencem em 30 dias', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Próximos 60 dias #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-yellow text-white avatar"><i class="ti ti-calendar-event"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.next60 }}</div>
                     <div class="text-secondary">{{ __('Vencem em 60 dias', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      {# Vencidos #}
      <div class="col-sm-6 col-lg">
         <div class="card card-sm">
            <div class="card-body">
               <div class="row align-items-center">
                  <div class="col-auto"><span class="bg-danger text-white avatar"><i class="ti ti-alert-triangle"></i></span></div>
                  <div class="col">
                     <div class="font-weight-medium h1 mb-0">{{ stats.expired }}</div>
                     <div class="text-secondary">{{ __('Vencidos', 'controlecontratos') }}</div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>

   <div class="card">
      <div class="card-header">
         <h3 class="card-title">
            {% if active_kind == 'contract' %}
               {{ __('Contratos', 'controlecontratos') }}
            {% elseif active_kind == 'license' %}
               {{ __('Licenças', 'controlecontratos') }}
            {% elseif active_kind == 'certificate' %}
               {{ __('Certificados', 'controlecontratos') }}
            {% elseif active_kind == 'domain' %}
               {{ __('Domínios', 'controlecontratos') }}
            {% else %}
               {{ __('Todos os registros', 'controlecontratos') }}
            {% endif %}
         </h3>
      </div>
      <div class="table-responsive">
         <table class="table table-vcenter card-table">
            <thead>
               <tr>
                  <th>{{ __('Tipo', 'controlecontratos') }}</th>
                  <th>{{ __('Nome', 'controlecontratos') }}</th>
                  <th>{{ __('Fornecedor', 'controlecontratos') }}</th>
                  <th>{{ __('Término', 'controlecontratos') }}</th>
                  <th>{{ __('Situação', 'controlecontratos') }}</th>
               </tr>
            </thead>
            <tbody>
               {% for row in rows %}
                  <tr>
                     <td>{{ row.kind_badge|raw }}</td>
                     <td><a href="{{ form_url }}?id={{ row.id }}">{{ row.name }}</a></td>
                     <td>{{ row.partner }}</td>
                     <td>{{ row.date_end|date('d/m/Y') }}</td>
                     <td>{{ row.status_badge|raw }}</td>
                  </tr>
               {% else %}
                  <tr><td colspan="5" class="text-center text-secondary">{{ __('Nenhum registro encontrado.', 'controlecontratos') }}</td></tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   </div>
</div>
