{#
 # Sino de notificações — CONTROLE DE CONTRATOS.
 # Botão flutuante fixo. Clicar dispensa o sino (some até o próximo login).
 # Injetado via display_central; a contagem vem dos contratos vencendo em 30 dias.
 #}
<a id="cc-bell" href="{{ dismiss_url }}"
   class="btn btn-primary shadow"
   style="position:fixed; bottom:20px; right:20px; z-index:1055; width:54px; height:54px;
          border-radius:50%; display:flex; align-items:center; justify-content:center;"
   title="{{ __('Contratos/Licenças vencendo — clique para dispensar', 'controlecontratos') }}">
   <i class="ti ti-bell" style="font-size:1.5rem;"></i>
   {% if count > 0 %}
      <span class="badge bg-red"
            style="position:absolute; top:-4px; right:-4px; border-radius:10px;">{{ count }}</span>
   {% endif %}
</a>
