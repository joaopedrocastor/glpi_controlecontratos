{#
 # Formulário do Contrato/Licença — CONTROLE DE CONTRATOS.
 # Estende o layout genérico do GLPI 10: herda <form>, token CSRF
 # (_glpi_csrf_token) e os botões salvar/excluir automaticamente.
 #}
{% extends "generic_show_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# Sobrescreve o bloco de campos do formulário genérico.
 # OBS: Nome, Usuário e Comentários já são renderizados pelo formulário-base
 # do GLPI (parte de cima), por isso NÃO são repetidos aqui. #}
{% block more_fields %}
   <div class="row">
      {# Seletor Contrato x Licença — diferenciação visual #}
      {% set kind_options = {} %}
      {% for key, data in kind_list %}
         {% set kind_options = kind_options|merge({(key): data.label}) %}
      {% endfor %}
      {{ fields.dropdownArrayField('kind', item.fields['kind'], kind_options, __('Tipo', 'controlecontratos'), {
         'required': true
      }) }}

      {{ fields.textField('partner', item.fields['partner'], __('Fornecedor', 'controlecontratos')) }}
   </div>

   <div class="row">
      {{ fields.dateField('date_begin', item.fields['date_begin'], __('Data de início', 'controlecontratos'), {
         'required': true
      }) }}
      {{ fields.dateField('date_end', item.fields['date_end'], __('Data de término', 'controlecontratos'), {
         'required': true
      }) }}
   </div>

   <div class="row">
      {# Periodicidade/duração do contrato (em meses) — como no módulo nativo #}
      {{ fields.dropdownArrayField('periodicity', item.fields['periodicity']|default(12), period_list, __('Periodicidade do contrato', 'controlecontratos')) }}

      {{ fields.dropdownArrayField('status', item.fields['status'], status_list, __('Status', 'controlecontratos')) }}
   </div>

   <div class="row">
      {# Aviso de término — antecedência em meses (armazenado em dias) #}
      {{ fields.dropdownArrayField('alert_days', item.fields['alert_days']|default(90), alert_list, __('Aviso de término', 'controlecontratos')) }}
   </div>

   <div class="row">
      {# Avisos por e-mail (além de WhatsApp/Telegram/Teams/Web Push) #}
      {{ fields.sliderField('email_alert', item.fields['email_alert']|default(0), __('Avisos por e-mail', 'controlecontratos')) }}
   </div>
{% endblock %}
